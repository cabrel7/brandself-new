        "services_tarif_check": {
          "name": "services_tarif_check",
          "value": "\"services\".\"tarif\" IN ('gratuit','payant','devis')"
        },
        "services_paiement_mode_check": {
          "name": "services_paiement_mode_check",
          "value": "\"services\".\"paiement_mode\" IS NULL OR \"services\".\"paiement_mode\" IN ('en_ligne','sur_place','au_choix')"
        },
        "services_rythme_check": {
          "name": "services_rythme_check",
          "value": "\"services\".\"rythme\" IS NULL OR \"services\".\"rythme\" IN ('hebdomadaire','bimensuel','mensuel','libre')"
        },
        "services_prix_devise_check": {
          "name": "services_prix_devise_check",
          "value": "\"services\".\"prix_devise\" IS NULL OR \"services\".\"prix_devise\" IN ('XAF','EUR','USD')"
        },
        "services_prix_montant_check": {
          "name": "services_prix_montant_check",
          "value": "\"services\".\"prix_montant\" IS NULL OR \"services\".\"prix_montant\" BETWEEN 1 AND 1000000000"
        },
        "services_duree_min_check": {
          "name": "services_duree_min_check",
          "value": "\"services\".\"duree_min\" IS NULL OR \"services\".\"duree_min\" BETWEEN 5 AND 1440"
        },
        "services_nb_seances_check": {
          "name": "services_nb_seances_check",
          "value": "\"services\".\"nb_seances\" IS NULL OR \"services\".\"nb_seances\" BETWEEN 2 AND 52"
        },
        "services_ordre_check": {
          "name": "services_ordre_check",
          "value": "\"services\".\"ordre\" >= 0"
        },
        "services_slug_format_check": {
          "name": "services_slug_format_check",
          "value": "char_length(\"services\".\"slug\") BETWEEN 1 AND 80 AND \"services\".\"slug\" ~ '^[a-z0-9]+(-[a-z0-9]+)*$'"
        },
        "services_inclus_check": {
          "name": "services_inclus_check",
          "value": "cardinality(\"services\".\"inclus\") <= 12"
        },
        "services_duree_requise_check": {
          "name": "services_duree_requise_check",
          "value": "\"services\".\"type\" = 'devis' OR \"services\".\"duree_min\" IS NOT NULL"
