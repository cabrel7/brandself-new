# Copier vers .env (jamais commité) et adapter à votre installation.
# Avec docker compose up : ces valeurs par défaut conviennent (sauf le secret, à changer).
DATABASE_URL=postgresql://brandself:brandself@localhost:5432/brandself_dev
REDIS_URL=redis://localhost:6379
NODE_ENV=development
# Signature des sessions Better Auth : 32 caractères minimum, à remplacer par une valeur aléatoire.
NUXT_BETTER_AUTH_SECRET=changez-moi-32-caracteres-minimum-1234
# Google (Better Auth) : les deux vont ensemble, sinon la connexion Google est désactivée.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# IA : anthropic | openai | faux | aucun (« openai » = tout fournisseur compatible OpenAI).
IA_FOURNISSEUR=
IA_CLE_API=
# Obligatoire si IA_FOURNISSEUR=openai.
IA_MODELE=
# Optionnelle (HTTPS) : adresse de l'API compatible OpenAI.
IA_BASE_URL=
# Expéditeur des e-mails (obligatoire en production) et URL publique du site (liens absolus).
EMAIL_EXPEDITEUR=
NUXT_PUBLIC_SITE_URL=

KPAY_WEBHOOK_SECRET=
KPAY_API_KEY=
KPAY_SECRET_KEY=
KPAY_BASE_URL=
KPAY_MODE_TEST_AUTORISE=