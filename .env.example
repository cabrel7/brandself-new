# Copier vers .env (jamais commité) et adapter à votre installation.
# Avec docker compose up : ces valeurs par défaut conviennent (sauf le secret, à changer).
DATABASE_URL=postgresql://brandself:brandself@localhost:5432/brandself_dev
REDIS_URL=redis://localhost:6379
NODE_ENV=development
# Signature des sessions Better Auth : 32 caractères minimum, à remplacer par une valeur aléatoire.
NUXT_BETTER_AUTH_SECRET=changez-moi-32-caracteres-minimum-1234
