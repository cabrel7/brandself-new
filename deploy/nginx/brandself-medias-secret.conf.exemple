# Secret de rafraîchissement du cache nginx des médias (/medias/). NE JAMAIS COMMITER le vrai fichier.
#
# Installation (une seule fois, puis à chaque rotation) :
#   sudo cp deploy/nginx/brandself-medias-secret.conf.exemple /etc/nginx/brandself-medias-secret.conf
#   sudo chown root:root /etc/nginx/brandself-medias-secret.conf && sudo chmod 640 /etc/nginx/brandself-medias-secret.conf
#   sudoedit /etc/nginx/brandself-medias-secret.conf    # remplacer CHANGER-MOI
#
# Génération : openssl rand -hex 32     (hexadécimal minuscule : nginx compare les clés de map sans
# tenir compte de la casse, un secret en minuscules évite toute ambiguïté)
# La MÊME valeur doit être celle de MEDIAS_CACHE_REFRESH_SECRET dans le .env de l'application.
# Ne jamais laisser CHANGER-MOI en production : la valeur est publique, n'importe qui pourrait forcer
# le contournement du cache (surcharge de Node). Le script deploy/verifier-cache-medias.sh refuse ce marqueur.
#
# Comparaison exacte : seule la valeur identique active le bypass ; en-tête absent ou différent => 0.
map $http_x_cache_refresh $bs_medias_refresh {
  default 0;
  "CHANGER-MOI" 1;
}
